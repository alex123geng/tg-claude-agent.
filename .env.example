# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:AA...                  # token from @BotFather
TELEGRAM_OWNER_ID=123456789                      # your numeric Telegram user id (from @userinfobot) — only this id is served
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string   # sent as secret_token to setWebhook and checked on every request

# === Server ===
PORT=3000

# === Claude Agent SDK auth (pick ONE of the two) ===
# a) pay-as-you-go API key from console.anthropic.com
ANTHROPIC_API_KEY=
# b) OAuth token from an existing Claude Pro/Max/Team subscription:
#    run `claude setup-token` locally once, paste the printed token here (valid ~1 year)
CLAUDE_CODE_OAUTH_TOKEN=

# === Paths (MUST be absolute, and MUST live on the mounted persistent volume in production) ===
AGENT_WORKDIR=/data/workspace
DB_PATH=/data/bot.sqlite

# === Voice ===
# whisper-local (free, runs whisper.cpp inside the container) or openai (paid, OpenAI Whisper API)
VOICE_PROVIDER=whisper-local
WHISPER_MODEL=base
# Where the local whisper model + compiled whisper.cpp binary live. The Dockerfile
# downloads/builds them at IMAGE BUILD time into /app/whisper-models (baked into the
# image itself), so this does NOT need to be on the persistent volume — every image
# build already reproduces it, and there's nothing to lose on redeploy.
WHISPER_MODEL_ROOT=/app/whisper-models
# Required only if VOICE_PROVIDER=openai
OPENAI_API_KEY=
