# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Your numeric Telegram user id (from.id). Only this user's messages are processed.
TELEGRAM_OWNER_ID=123456789
# Random long string, also passed to setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# Public HTTPS URL of this service (used only by npm run set-webhook), e.g. the Railway domain.
PUBLIC_URL=https://your-app.up.railway.app

# Claude auth: set EXACTLY ONE of the following two.
# a) Paid API key from console.anthropic.com
ANTHROPIC_API_KEY=
# b) OAuth token from an existing Pro/Max/Team subscription (`claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: override the model used by the agent (defaults to the SDK/CLI default).
CLAUDE_MODEL=

# Absolute paths. On Railway these MUST live under the mounted Volume path
# (e.g. a volume mounted at /data), otherwise data is wiped on every redeploy.
AGENT_WORKDIR=/data/workspace
DB_PATH=/data/bot.sqlite

# HTTP port the Express server listens on.
PORT=3000

# Local whisper.cpp model (tiny.en/base.en/small.en/medium.en/large-v3-turbo/...).
# Must match the model baked into the Docker image at build time (see Dockerfile).
WHISPER_MODEL=base.en
# Leave unset: the model is already downloaded into node_modules at image
# build time. Only set this if you want it cached on the persistent volume
# instead (you'd then need to pre-warm that path yourself).
WHISPER_MODEL_ROOT=
