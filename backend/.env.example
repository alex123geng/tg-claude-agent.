# PostgreSQL connection string. Оставь пустым для локальной разработки — тогда
# используется файл SQLite backend/local.db.
# На Railway бери значение через Reference на переменную PostgreSQL-сервиса.
DATABASE_URL=

# Секрет для подписи JWT-токенов. Любая случайная длинная строка.
SECRET_KEY=

# Секретный ключ для доступа к /admin/* эндпоинтам (передаётся как ?key=...).
# Любая случайная строка.
ADMIN_KEY=

# Сколько минут живёт токен авторизации после входа. По умолчанию 10080 (7 дней).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Приветственный бонус при регистрации.
WELCOME_BONUS=100

# Процент кэшбэка, начисляемый при переводе заказа в статус "done".
CASHBACK_PERCENT=5

# OAuth-токен Яндекс.Диска для синхронизации заявок и бонусов в xlsx-таблицы.
# Получить на https://oauth.yandex.ru с правом "Запись в любом месте на Диске".
# Если не задан — синхронизация просто отключена.
YANDEX_DISK_TOKEN=
