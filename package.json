{
  "name": "tg-claude-agent",
  "version": "1.0.0",
  "description": "Telegram bot that runs a full Claude Code-style agent (Claude Agent SDK) as a webhook service.",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "set-webhook": "node scripts/set-webhook.cjs",
    "delete-webhook": "node scripts/delete-webhook.cjs",
    "warmup-whisper": "node scripts/warmup-whisper.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.224",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "nodejs-whisper": "^0.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
